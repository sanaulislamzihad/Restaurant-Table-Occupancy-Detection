# Backend configuration template.
# Copy to backend/.env and adjust:
#   Windows:      copy backend\.env.example backend\.env
#   Linux/macOS:  cp backend/.env.example backend/.env
# Relative paths are resolved from the backend/ folder.

# ---------- API server ----------
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins allowed to call the API (comma-separated). Default: Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- External tools ----------
# A command on PATH or a path to the executable (".exe" is optional on Windows).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIAMTX_PATH=../fake_camera/bin/mediamtx
MEDIAMTX_CONFIG=../fake_camera/mediamtx.yml
# Start MediaMTX automatically when nothing is listening on the RTSP port.
MANAGE_MEDIAMTX=true

# ---------- Fake CCTV camera ----------
# MediaMTX listens on this URL's port, ffmpeg publishes the selected video to it,
# and new table configs use it as their default source. A real camera is
# configured per table config, not here.
FAKE_CAMERA_RTSP_URL=rtsp://localhost:8554/cam1

# ---------- Storage ----------
VIDEOS_DIR=../fake_camera/videos
CONFIGS_DIR=configs
# SQLite database and video thumbnails.
DATA_DIR=data
MAX_UPLOAD_MB=500

# ---------- Video source ----------
# Seconds to wait before reconnecting to a dropped stream or camera.
SOURCE_RECONNECT_SECONDS=3
# Give up opening / reading a stream after this many seconds, then reconnect.
SOURCE_OPEN_TIMEOUT_SECONDS=10
SOURCE_READ_TIMEOUT_SECONDS=10
# Restart video files from the beginning when they end, like a looping camera.
LOOP_VIDEO_FILES=true

# ---------- Detection ----------
YOLO_MODEL=yolo11n.pt
# auto = NVIDIA GPU (CUDA) when available, otherwise CPU. Or force: cpu, cuda, cuda:0
DEVICE=auto
# Run YOLO on every Nth frame (1 = every frame). Raise it to save CPU.
DETECT_EVERY_N_FRAMES=1
