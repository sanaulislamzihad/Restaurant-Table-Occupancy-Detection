# Backend configuration template.
# Copy to backend/.env and adjust:
#   Windows:      copy backend\.env.example backend\.env
#   Linux/macOS:  cp backend/.env.example backend/.env
# Relative paths are resolved from the backend/ folder.

# ---------- API server ----------
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins allowed to call the API (comma-separated). Default: Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- External tools ----------
# A command on PATH or a path to the executable (".exe" is optional on Windows).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIAMTX_PATH=../fake_camera/bin/mediamtx
MEDIAMTX_CONFIG=../fake_camera/mediamtx.yml
# Start MediaMTX automatically when nothing is listening on the RTSP port.
MANAGE_MEDIAMTX=true

# ---------- Fake CCTV camera ----------
# MediaMTX listens on this URL's port, ffmpeg publishes the selected video to it,
# and new table configs use it as their default source. A real camera is
# configured per table config, not here.
FAKE_CAMERA_RTSP_URL=rtsp://localhost:8554/cam1

# ---------- Storage ----------
VIDEOS_DIR=../fake_camera/videos
CONFIGS_DIR=configs
# SQLite database and video thumbnails.
DATA_DIR=data
MAX_UPLOAD_MB=500

# ---------- Video source ----------
# Seconds to wait before reconnecting to a dropped stream or camera.
SOURCE_RECONNECT_SECONDS=3
# Give up opening / reading a stream after this many seconds, then reconnect.
SOURCE_OPEN_TIMEOUT_SECONDS=10
SOURCE_READ_TIMEOUT_SECONDS=10
# Restart video files from the beginning when they end, like a looping camera.
LOOP_VIDEO_FILES=true

# ---------- Detection ----------
# Model weights: a file name inside MODELS_DIR (official weights are downloaded
# there on first use) or a path to your own weights. On overhead CCTV footage
# yolo26s.pt finds about 4x more small, partly hidden seated people than
# yolo11n.pt, at ~170 ms per frame on a laptop CPU (yolo11n.pt: ~45 ms).
YOLO_MODEL=yolo26s.pt
MODELS_DIR=models
# auto = NVIDIA GPU (CUDA) when available, otherwise CPU. Or force: cpu, cuda, cuda:0
DEVICE=auto
# Image size YOLO works at (multiple of 32). Smaller is faster on CPU, less accurate.
YOLO_IMG_SIZE=640
# Minimum person confidence (0-1). Each table config can set its own value.
# The tracker only starts a new person from a detection of 0.25 or more; weaker
# detections only keep already tracked people (e.g. half hidden) from dropping out.
CONFIDENCE_THRESHOLD=0.15
# Run YOLO on every Nth frame (1 = every frame). Raise it to save CPU.
DETECT_EVERY_N_FRAMES=1

# ---------- Live pipeline ----------
# Video ID (table config) to watch when the backend starts, e.g. restaurant.
# Empty: start with the fake camera and no tables. `python -m app --video <id>` overrides it.
DEFAULT_VIDEO_ID=
# JPEG quality of the annotated live stream (1-100).
STREAM_JPEG_QUALITY=80

# ---------- Occupancy (defaults for new table configs) ----------
# A table turns OCCUPIED after someone has been at it continuously this long ...
ENTER_SECONDS=5
# ... and AVAILABLE again after nobody has been at it continuously this long.
LEAVE_SECONDS=10
# Point of a person's box that must be inside a table polygon: bottom_center or center.
REFERENCE_POINT=bottom_center
